        <ntu:hasEmotion rdf:resource="http://ntu.edu.vn/feedback_system#Emo_HaiLong" />
        <ntu:aboutTopic rdf:resource="http://ntu.edu.vn/feedback_system#Topic_Khac" />
        <ntu:hasQuestionType rdf:resource="http://ntu.edu.vn/feedback_system#QType_UuDiem" />
        <ntu:aboutLecturer rdf:resource="http://ntu.edu.vn/feedback_system#Lecturer_GV_022" />
        <ntu:aboutCourse rdf:resource="http://ntu.edu.vn/feedback_system#Course_MAT327" />
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1500">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Thầy dạy miên man không cho chép bài đang giảng bài cứ nói sang chuyện khác lúc hỏi lại thì đố ai mà tập trung được em đã học khó nhớ còn gặp thầy nói mãi kh cho chép bảo về nhà mới chép v nhà thì hiểu được gì nếu trường hợp gặp mấy bạn lười không về chép thì sao ?</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Neutral" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Medium" />
        <ntu:belongsToAcademicTerm rdf:resource="http://ntu.edu.vn/feedback_system#Term_HK1_2023_2024" />
