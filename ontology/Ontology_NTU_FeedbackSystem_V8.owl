    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_664">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Em cảm ơn thầy đã gánh em qua môn , kỳ trước em học tin chán lắm nhưng bây giờ em học tin thì môn tin nó vẫn chán nhưng nhờ có thầy thì em thấy nó vui hơn, giờ mà em ghi môn tin nó vẫn chán chắc thầy show cái đánh giá của em lên cho cả lớp thầy đang dạy coi quá . Em cảm ơn thầy rất nhiều ạ , thầy nhớ giữ gìn sức khỏe thật tốt để quánh giá nhiều đứa sinh viên khác nha , hẹn không gặp lại thầy ở môn tin mà ở một khác ạ . FC</ntu:hasContent>
