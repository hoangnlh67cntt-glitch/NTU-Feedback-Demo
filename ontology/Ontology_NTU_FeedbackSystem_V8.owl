    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1889">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Dạ cô luôn tạo cơ hội để sinh viên có thể trao đổi với cô nhiều hơn khi không hiểu bài. Luôn lắng nghe ý kiến của sinh viên, cô rất dễ gần nên tạo cho chúng em một môi trường học tập thoải mái. Cô cho nhiều bài tập để rèn luyện hơn</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Negative" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_High" />
        <ntu:belongsToAcademicTerm rdf:resource="http://ntu.edu.vn/feedback_system#Term_HK1_2023_2024" />
