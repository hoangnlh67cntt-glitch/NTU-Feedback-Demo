    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1928">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Cô [ẨN_DANH] là 1 giảng viên cực kì tốt, dễ thương, hiền và có rất nhiều kiến thức để truyền đạt đến sinh viên. Cô có rất nhiều những cách giảng bài và đưa ra mẹo để học rất siêu dễ nhớ. Cô cũng rất nhiệt tình trong việc sửa chữa bài tập và giải đáp thắc mắc cho các bạn sinh viên. Cô rất là tuyệt vời!</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Positive" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Low" />
        <ntu:belongsToAcademicTerm rdf:resource="http://ntu.edu.vn/feedback_system#Term_HK1_2023_2024" />
        <ntu:generatedFromSource rdf:resource="http://ntu.edu.vn/feedback_system#Src_LMS_NTU" />
        <ntu:hasDataOrigin rdf:resource="http://ntu.edu.vn/feedback_system#Orig_NTU_GOC" />
        <ntu:hasEmotion rdf:resource="http://ntu.edu.vn/feedback_system#Emo_KhenNgoi" />
        <ntu:aboutTopic rdf:resource="http://ntu.edu.vn/feedback_system#Topic_TaiLieu" />
        <ntu:hasQuestionType rdf:resource="http://ntu.edu.vn/feedback_system#QType_UuDiem" />
        <ntu:aboutLecturer rdf:resource="http://ntu.edu.vn/feedback_system#Lecturer_GV_030" />
        <ntu:aboutCourse rdf:resource="http://ntu.edu.vn/feedback_system#Course_MAT322" />
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1929">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Em nghĩ rằng Nhà trường cố gắng đầu tư cải thiện hệ thống máy chiếu để giúp cho giảng viên và sinh viên sẽ có được những buổi học hiệu quả và đạt chất lượng tốt nhất!</ntu:hasContent>
