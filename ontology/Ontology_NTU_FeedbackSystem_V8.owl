    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_629">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>thầy cô nào chứ riêng GV này, dù cho bộ môn có họp và đã góp ý nhằm nâng cao chất lượng giảng dạy nhưng GV này không tiếp thu, không chịu thay đổi thì làm sao nâng cao được chất lượng?</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Neutral" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Medium" />
