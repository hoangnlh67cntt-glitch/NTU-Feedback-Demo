        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Lecturer" />
        <rdfs:range rdf:resource="xsd:string" />
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasGroupCode">
