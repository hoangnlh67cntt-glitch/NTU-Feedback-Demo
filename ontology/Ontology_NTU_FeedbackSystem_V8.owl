    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasConfidence">
        <rdfs:label xml:lang="vi">hasConfidence</rdfs:label>
        <rdfs:comment xml:lang="vi">Độ tin cậy dự đoán NLP (0.0–1.0)</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="xsd:float" />
    </owl:DatatypeProperty>

    
    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasAcademicYear">
        <rdfs:label xml:lang="vi">hasAcademicYear</rdfs:label>
        <rdfs:comment xml:lang="vi">Năm học dạng chuỗi, ví dụ: 2023-2024</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#AcademicTerm" />
        <rdfs:range rdf:resource="xsd:string" />
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasSemester">
        <rdfs:label xml:lang="vi">hasSemester</rdfs:label>
        <rdfs:comment xml:lang="vi">Số kỳ học: 1 hoặc 2</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#AcademicTerm" />
        <rdfs:range rdf:resource="xsd:integer" />
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasPriorityScore">
        <rdfs:label xml:lang="vi">hasPriorityScore</rdfs:label>
        <rdfs:comment xml:lang="vi">Điểm ưu tiên xử lý (0.0 = thấp, 1.0 = khẩn cấp)</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Recommendation" />
        <rdfs:range rdf:resource="xsd:float" />
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasSourceName">
