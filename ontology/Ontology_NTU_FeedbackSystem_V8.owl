        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>GV chú trọng những cái thật sự cần cho SV, luôn luôn hướng dẫn chi tiết, đặc biệt tạo điều kiện cho sinh viên.</ntu:hasContent>
