    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1930">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>giảng viên giảng quá nhanh, em và nhiều bạn học khác không theo kịp. mong cô có thể nói chậm và giảng chi tiết hơn ạ.</ntu:hasContent>
