    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_437">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Cô giảng rất chậm và rất kỹ đặt biệt là những kiến thức quan trọng. Cô luôn luôn lắng nghe và tạo điều kiện cho sinh viên.</ntu:hasContent>
