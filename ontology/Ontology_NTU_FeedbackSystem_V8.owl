        <ntu:aboutLecturer rdf:resource="http://ntu.edu.vn/feedback_system#Lecturer_GV_024" />
        <ntu:aboutCourse rdf:resource="http://ntu.edu.vn/feedback_system#Course_MAT327" />
    </owl:NamedIndividual>

