    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1504">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Vì thầy quá nhiệt tình đôi lúc thấy cố giảng cho sinh viên hiểu nhưng thầy quá nhiệt tình nên đôi lúc cảm xúc hơi thất thường nên sinh viên hơi hồi hộp khi học ạ</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Positive" />
