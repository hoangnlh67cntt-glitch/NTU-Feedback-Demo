    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1501">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Thầy [ẨN_DANH] nhiệt tình và yêu thương học sinh lắm ạ, thầy làm cho môn Toán trở nên dễ hiểu hơn, thầy dạy bản chất và dạy học sinh cách tư duy logic, áp dụng vào trong cuộc sống, thầy còn hài hước nữa ạ</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Neutral" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Medium" />
