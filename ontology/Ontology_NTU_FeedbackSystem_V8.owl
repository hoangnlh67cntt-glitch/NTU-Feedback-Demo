    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_627">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Em nghĩ thầy nên để ý đến sinh viên hơn Vd như tụi em không hiểu hay không biết thì thầy nên chỉ cụ thể , chứ đừng kêu tụi em nhìn sách , tụi em không rõ phần đó thì mới hỏi thầy ( mong thầy có thể rút kinh nghiệm hơn )</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Neutral" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Medium" />
