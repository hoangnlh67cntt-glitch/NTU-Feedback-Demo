<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:ntu="http://ntu.edu.vn/feedback_system#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://ntu.edu.vn/feedback_system">

    <owl:Ontology rdf:about="http://ntu.edu.vn/feedback_system">
        <rdfs:label>NTU Feedback System Ontology V8 (Extended)</rdfs:label>
        <rdfs:comment>Ontology mở rộng: quản lý phản hồi sinh viên - ĐH Nha Trang V8</rdfs:comment>
    </owl:Ontology>

    
    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Feedback">
        <rdfs:label xml:lang="vi">Feedback</rdfs:label>
        <rdfs:comment xml:lang="vi">Phản hồi mở của sinh viên về học phần</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Course">
        <rdfs:label xml:lang="vi">Course</rdfs:label>
        <rdfs:comment xml:lang="vi">Học phần được đánh giá</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Lecturer">
        <rdfs:label xml:lang="vi">Lecturer</rdfs:label>
        <rdfs:comment xml:lang="vi">Giảng viên được đề cập trong phản hồi</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#QuestionType">
        <rdfs:label xml:lang="vi">QuestionType</rdfs:label>
        <rdfs:comment xml:lang="vi">Loại câu hỏi: UuDiem / GopYGV / GopYNT</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Sentiment">
        <rdfs:label xml:lang="vi">Sentiment</rdfs:label>
        <rdfs:comment xml:lang="vi">Cảm xúc tổng thể: Positive/Neutral/Negative</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Emotion">
        <rdfs:label xml:lang="vi">Emotion</rdfs:label>
        <rdfs:comment xml:lang="vi">Cảm xúc chi tiết: KhenNgoi/HaiLong/DeXuat/PhanNan/ThatVong/KhongYKien</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Topic">
        <rdfs:label xml:lang="vi">Topic</rdfs:label>
        <rdfs:comment xml:lang="vi">Chủ đề: GiangDay/TaiLieu/CoSoVatChat/ThoiGian/DanhGiaCongBang/ThaiDo/Khac</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Suggestion">
        <rdfs:label xml:lang="vi">Suggestion</rdfs:label>
        <rdfs:comment xml:lang="vi">Góp ý cải tiến trích xuất từ phản hồi</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#AcademicTerm">
        <rdfs:label xml:lang="vi">AcademicTerm</rdfs:label>
        <rdfs:comment xml:lang="vi">Kỳ học: HK1_2023_2024, HK2_2023_2024, ...</rdfs:comment>
    </owl:Class>

    
    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Department">
        <rdfs:label xml:lang="vi">Department</rdfs:label>
        <rdfs:comment xml:lang="vi">Bộ môn/Khoa chuyên ngành (ví dụ: Khoa CNTT, Khoa Kinh tế)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Faculty">
        <rdfs:label xml:lang="vi">Faculty</rdfs:label>
        <rdfs:comment xml:lang="vi">Đơn vị cấp trường / khoa mẹ quản lý nhiều Department</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#SeverityLevel">
        <rdfs:label xml:lang="vi">SeverityLevel</rdfs:label>
        <rdfs:comment xml:lang="vi">Mức độ nghiêm trọng: Low / Medium / High / Critical</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#Recommendation">
        <rdfs:label xml:lang="vi">Recommendation</rdfs:label>
        <rdfs:comment xml:lang="vi">Khuyến nghị hành động cụ thể phát sinh từ phân tích phản hồi</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#FeedbackSource">
        <rdfs:label xml:lang="vi">FeedbackSource</rdfs:label>
        <rdfs:comment xml:lang="vi">Kênh/phương thức thu thập phản hồi: LMS, Phiếu giấy, Form online</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://ntu.edu.vn/feedback_system#DataOrigin">
        <rdfs:label xml:lang="vi">DataOrigin</rdfs:label>
        <rdfs:comment xml:lang="vi">Xuất xứ dữ liệu: phân biệt NTU gốc, tái gán nhãn hay augmented</rdfs:comment>
    </owl:Class>

    
    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#aboutCourse">
        <rdfs:label xml:lang="vi">aboutCourse</rdfs:label>
        <rdfs:comment xml:lang="vi">Phản hồi thuộc học phần nào</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Course" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#aboutLecturer">
        <rdfs:label xml:lang="vi">aboutLecturer</rdfs:label>
        <rdfs:comment xml:lang="vi">Phản hồi đề cập giảng viên nào</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Lecturer" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#hasSentiment">
        <rdfs:label xml:lang="vi">hasSentiment</rdfs:label>
        <rdfs:comment xml:lang="vi">Cảm xúc tổng thể</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Sentiment" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#hasEmotion">
        <rdfs:label xml:lang="vi">hasEmotion</rdfs:label>
        <rdfs:comment xml:lang="vi">Cảm xúc chi tiết</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Emotion" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#aboutTopic">
        <rdfs:label xml:lang="vi">aboutTopic</rdfs:label>
        <rdfs:comment xml:lang="vi">Chủ đề được đề cập</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Topic" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#hasQuestionType">
        <rdfs:label xml:lang="vi">hasQuestionType</rdfs:label>
        <rdfs:comment xml:lang="vi">Loại câu hỏi khảo sát</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#QuestionType" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#hasSuggestion">
        <rdfs:label xml:lang="vi">hasSuggestion</rdfs:label>
        <rdfs:comment xml:lang="vi">Góp ý cải tiến</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Suggestion" />
    </owl:ObjectProperty>

    
    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#hasSeverityLevel">
        <rdfs:label xml:lang="vi">hasSeverityLevel</rdfs:label>
        <rdfs:comment xml:lang="vi">Mức độ nghiêm trọng của phản hồi (tự động hoặc chuyên gia gán)</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#SeverityLevel" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#recommendsAction">
        <rdfs:label xml:lang="vi">recommendsAction</rdfs:label>
        <rdfs:comment xml:lang="vi">Khuyến nghị hành động được đề xuất từ phản hồi này</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Recommendation" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#belongsToAcademicTerm">
        <rdfs:label xml:lang="vi">belongsToAcademicTerm</rdfs:label>
        <rdfs:comment xml:lang="vi">Phản hồi thuộc kỳ học nào</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#AcademicTerm" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#belongsToDepartment">
        <rdfs:label xml:lang="vi">belongsToDepartment</rdfs:label>
        <rdfs:comment xml:lang="vi">Học phần thuộc bộ môn/khoa nào (Course → Department)</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Course" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Department" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#belongsToFaculty">
        <rdfs:label xml:lang="vi">belongsToFaculty</rdfs:label>
        <rdfs:comment xml:lang="vi">Bộ môn/khoa thuộc đơn vị cấp trường nào</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Department" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Faculty" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#generatedFromSource">
        <rdfs:label xml:lang="vi">generatedFromSource</rdfs:label>
        <rdfs:comment xml:lang="vi">Phản hồi được thu thập qua kênh nào</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#FeedbackSource" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#hasDataOrigin">
        <rdfs:label xml:lang="vi">hasDataOrigin</rdfs:label>
