    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1819">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>thầy dạy chỉ 1/3 thời gian còn lại toàn ngồi không,giảng và dạy bài mới quá ít chỉ lấy 1 vd giải và tí lý thuyết còn lại kêu xem sách giáo khoa,vì 1 2 người ồn mà chửi cả lớp và không dạy nữa làm mất cả buổi kiến thức,dạy cho vd bt và thi quá khắc biệt nên người sinh viên ngộp vì năm đầu mà hơi khó.</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Neutral" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Medium" />
        <ntu:belongsToAcademicTerm rdf:resource="http://ntu.edu.vn/feedback_system#Term_HK1_2023_2024" />
        <ntu:generatedFromSource rdf:resource="http://ntu.edu.vn/feedback_system#Src_LMS_NTU" />
