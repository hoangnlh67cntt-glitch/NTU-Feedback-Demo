    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1502">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>nâng cấp cơ sở vật chất thêm nhà xe, sử dụng triết để ko gian diện tích vốn có của trường, quá ít sân cho hoạt động thể thao, mở lại kí túc xá K6, khu tự học rất rất rất là nhiều mũi</ntu:hasContent>
