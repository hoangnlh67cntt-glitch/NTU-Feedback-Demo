    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1499">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Em rất cám mơn thầy, dù thầy dạy có chút khắt khe nhưng đó là thứ giúp chúng em nên người hơn và học tập tốt hơn, em rất thích cách truyền tải của thầy nó rất dể hiểu và thực tế, em không nghỉ là học môn toán này sẽ dể nhưng khi được thầy dạy thì cái suy nghỉ đó của em đã sai, em rất quý thầy</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Positive" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Low" />
        <ntu:belongsToAcademicTerm rdf:resource="http://ntu.edu.vn/feedback_system#Term_HK1_2023_2024" />
        <ntu:generatedFromSource rdf:resource="http://ntu.edu.vn/feedback_system#Src_LMS_NTU" />
