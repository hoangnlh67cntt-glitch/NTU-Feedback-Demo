    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_1503">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>lên lớp thầy hơi la làm tụi em giật mình thui , nhưng mà thầy vẫn dễ thương lắm ạ , thầy chỉ dạy tụi em rồi chắt chiu từng chút cho tụi em hiểu nữa í, thầy tuyệt vờiiiiiiiii lắm ạ</ntu:hasContent>
        <ntu:hasSentiment rdf:resource="http://ntu.edu.vn/feedback_system#Sent_Positive" />
        <ntu:hasSeverityLevel rdf:resource="http://ntu.edu.vn/feedback_system#Sev_Low" />
        <ntu:belongsToAcademicTerm rdf:resource="http://ntu.edu.vn/feedback_system#Term_HK1_2023_2024" />
