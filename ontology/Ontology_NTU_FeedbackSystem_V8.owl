        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#DataOrigin" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ntu.edu.vn/feedback_system#lecturerBelongsToDept">
        <rdfs:label xml:lang="vi">lecturerBelongsToDept</rdfs:label>
        <rdfs:comment xml:lang="vi">Giảng viên thuộc bộ môn/khoa nào</rdfs:comment>
        <rdfs:domain rdf:resource="http://ntu.edu.vn/feedback_system#Lecturer" />
        <rdfs:range rdf:resource="http://ntu.edu.vn/feedback_system#Department" />
    </owl:ObjectProperty>

    
    <owl:DatatypeProperty rdf:about="http://ntu.edu.vn/feedback_system#hasContent">
        <rdfs:label xml:lang="vi">hasContent</rdfs:label>
        <rdfs:comment xml:lang="vi">Nội dung văn bản phản hồi gốc</rdfs:comment>
