    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_746">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>đầu tư máy chiếu để chất lượng giảng dạy được nâng cao :&gt; nhiều khi em ngồi đầu mà hình chiếu còn nhìn không rõ (không phải do môi trường ánh sáng các thứ các thứ...mà máy cũ rồi nên đổi thôi trường ơi :D)</ntu:hasContent>
