    <owl:NamedIndividual rdf:about="http://ntu.edu.vn/feedback_system#FB_436">
        <rdf:type rdf:resource="http://ntu.edu.vn/feedback_system#Feedback" />
        <ntu:hasContent>Giảng viên nắm chắc nội dung học phần, luôn giải đáp mọi thắc mắc của sinh viên và đưa ra các nhận xét giúp sinh viên cải thiện kỹ năng và kiến thức.</ntu:hasContent>
